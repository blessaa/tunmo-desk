# HTTP 服务
HOST=192.168.3.112
PORT=3000
LOG_LEVEL=info

# 生产环境必须配置。未配置时仅用于本地开发，所有请求映射为 development-user。
AUTH_TOKEN=
AUTH_OWNER_ID=local-user
WS_TICKET_TTL_MS=60000
ALLOWED_ORIGINS=http://localhost:3000,http://192.168.3.112:3000

# 默认使用 npm 依赖中内置的 Pi RPC entry，无需配置或全局安装 pi。
# 下列配置仅用于显式覆盖，例如切换到单独构建的新 Pi fork：
# PI_RPC_COMMAND=node
# PI_RPC_ARGS=["/absolute/path/to/pi-main/packages/coding-agent/dist/cli.js","--mode","rpc"]

# 对话工作目录必须位于此根目录内；为空时使用服务启动目录。
PI_CWD_ROOT=
PI_DEFAULT_CWD=
PI_SESSION_DIR=
PI_PROVIDER=
PI_MODEL=

PI_START_TIMEOUT_MS=15000
PI_COMMAND_TIMEOUT_MS=30000
PI_INTERRUPT_TIMEOUT_MS=10000
PI_STOP_GRACE_MS=2000
MAX_ACTIVE_PI_PROCESSES=8
REPLAY_CAPACITY=2000
CONVERSATION_IDLE_TTL_MS=900000
MAX_FRAME_BYTES=1048576
MAX_WS_BUFFERED_BYTES=1048576
MAX_RPC_PER_MINUTE=120
WS_HEARTBEAT_MS=30000
EXPOSE_THINKING=false
